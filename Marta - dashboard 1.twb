              </zone>
              <zone forceUpdate='true' h='45107' id='13' type-v2='text' w='12425' x='42569' y='53821'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>The highest loan amounts were taken out by individuals aged between 25 and 60, while the lowest amounts were observed among those aged 65 to 85.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>The amount of loans taken out by both genders is nearly the same.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='45107' id='14' type-v2='text' w='13174' x='86401' y='53821'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>The highest withdrawal amounts were recorded among individuals aged 25–30 and 35–50, while the lowest amounts came from those over 65 years old. Withdrawal amounts were nearly the same for both genders.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
