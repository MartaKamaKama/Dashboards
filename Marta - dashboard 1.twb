            <zone h='9383' id='11' mode='checkdropdown' name='Avg Amount by Age Group and Gender' param='[federated.0dv03z01yoejqf161bpiu1ijrz1z].[none:GENDER:nk]' type-v2='filter' values='database' w='9988' x='425' y='1072'>
