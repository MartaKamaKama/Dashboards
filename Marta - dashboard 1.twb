    <dashboard enable-sort-zone-taborder='true' name='Age Group/Gender vs Avg Amount spent for Credits/Withdrawals'>
      <style />
      <size sizing-mode='automatic' />
      <datasources>
        <datasource caption='transactions1.csv+ (Multiple Connections)' name='federated.0dv03z01yoejqf161bpiu1ijrz1z' />
      </datasources>
      <datasource-dependencies datasource='federated.0dv03z01yoejqf161bpiu1ijrz1z'>
