    <worksheet name='Top 10 Agensts Response Time'>
      <table>
        <view>
          <datasources>
            <datasource caption='customer support data' name='federated.122s7m11vtpgg218p3irq0y40v1v' />
          </datasources>
          <datasource-dependencies datasource='federated.122s7m11vtpgg218p3irq0y40v1v'>
            <column datatype='string' name='[Agent Shift]' role='dimension' type='nominal' />
            <column datatype='string' name='[Agent_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Not assigned' />
              </aliases>
            </column>
            <column caption='Response time' datatype='integer' name='[Calculation_881298187041267712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [Issue_reported at], [issue_responded])' />
