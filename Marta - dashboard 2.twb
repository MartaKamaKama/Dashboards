    <worksheet name='Avg Response Time'>
      <table>
        <view>
          <datasources>
            <datasource caption='customer support data' name='federated.122s7m11vtpgg218p3irq0y40v1v' />
          </datasources>
          <datasource-dependencies datasource='federated.122s7m11vtpgg218p3irq0y40v1v'>
            <column datatype='string' name='[Agent Shift]' role='dimension' type='nominal' />
            <column datatype='string' name='[Agent_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Not assigned' />
              </aliases>
            </column>
            <column caption='Response time' datatype='integer' name='[Calculation_881298187041267712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [Issue_reported at], [issue_responded])' />
            </column>
            <column datatype='datetime' name='[Issue_reported at]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Manager]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_881298187041267712]' derivation='Avg' name='[avg:Calculation_881298187041267712:qk]' pivot='key' type='quantitative' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[issue_responded]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.122s7m11vtpgg218p3irq0y40v1v].[Action (Agent Shift)]'>
            <groupfilter function='level-members' level='[Agent Shift]' user:ui-action-filter='[Action12_3472ECFF3E3F4426BF1454D94319360E]' user:ui-enumeration='all' user:ui-marker='enumerate' />
